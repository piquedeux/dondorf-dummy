# Copy this file to `.env` and fill in your own values.
# The file is loaded by site/config/config.php at runtime.

# Kirby security secrets — generate random values, e.g. `openssl rand -hex 32`
KIRBY_CONTENT_SALT=
KIRBY_COOKIE_KEY=

# SMTP — outgoing mail for booking confirmations and newsletter notifications
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURITY=tls
SMTP_USERNAME=
SMTP_PASSWORD=
