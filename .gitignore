# ─── Kirby runtime / generated data ──────────────────────────────────
/media/*
!/media/index.html
/site/accounts/*
!/site/accounts/index.html
/site/cache/*
!/site/cache/index.html
/site/sessions/*
!/site/sessions/index.html

# Mirror of the site content, generated by the content-storage plugin
/content/site-sections/

# Runtime submissions (bookings, newsletter subscribers, stats)
/content/bookings/*/
/content/newsletter/*/
/site/data/
/site/logs/

# ─── Secrets ─────────────────────────────────────────────────────────
.env
/site/config/.license

# ─── Composer-managed plugins & dependencies ─────────────────────────
/kirby/
/vendor/
/site/plugins/kirby-flash/
/site/plugins/kirby-form/
/site/plugins/kirby-uniform/

# ─── OS / editor ─────────────────────────────────────────────────────
.DS_Store
Thumbs.db
*.log
.vscode/
.idea/
*.swp
